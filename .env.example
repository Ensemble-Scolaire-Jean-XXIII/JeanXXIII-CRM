# Ne pas activer en dev (les requêtes viennent en direct du navigateur).
TRUST_PROXY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

LEXPRESS_API_URL=
LEXPRESS_USER=
LEXPRESS_API_KEY=

WEBHOOK_SECRET=