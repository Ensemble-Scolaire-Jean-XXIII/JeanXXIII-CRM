# Dev only
FRONTEND_PORT=3000
BACKEND_PORT=5000
DB_PORT=3306
NEXT_PUBLIC_API_URL=

# Prod + Dev
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

FRONTEND_URL=

# Au moins 32 caractères — générer : openssl rand -hex 32
